<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ИИ Решатель</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            background: #121212;
            color: #ffffff;
            margin: 0;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        input, button {
            width: 100%;
            max-width: 400px;
            padding: 14px;
            margin: 8px 0;
            border-radius: 12px;
            border: none;
            font-size: 16px;
            box-sizing: border-box;
        }
        input[type="password"] {
            background: #2c2c2e;
            color: white;
        }
        .camera-btn {
            background: #0a84ff;
            color: white;
            font-weight: bold;
            text-align: center;
            cursor: pointer;
            display: block;
            width: 100%;
            max-width: 400px;
            padding: 16px;
            border-radius: 12px;
            margin: 10px 0;
            box-sizing: border-box;
        }
        #preview {
            max-width: 100%;
            max-height: 250px;
            border-radius: 12px;
            display: none;
            margin: 10px 0;
        }
        #result {
            width: 100%;
            max-width: 400px;
            background: #1c1c1e;
            padding: 16px;
            border-radius: 12px;
            margin-top: 12px;
            white-space: pre-wrap;
            line-height: 1.5;
            box-sizing: border-box;
        }
    </style>
</head>
<body>

    <h2>⚡ Быстрый ИИ-Решатель</h2>
    
    <!-- Поле для твоего API ключа -->
    <input type="password" id="apiKey" placeholder="Вставь сюда Gemini API Key">

    <!-- Скрытый input для вызова камеры телефона -->
    <label class="camera-btn">
        📸 Сфоткать задачу
        <input type="file" id="cameraInput" accept="image/*" capture="environment" style="display:none;">
    </label>

    <img id="preview" alt="Превью фото">
    <div id="result">Сделай фото задачи, и ответ появится здесь...</div>

    <script>
        const apiKeyInput = document.getElementById('apiKey');
        const cameraInput = document.getElementById('cameraInput');
        const preview = document.getElementById('preview');
        const resultDiv = document.getElementById('result');

        // Сохраняем ключ в памяти браузера, чтобы не вводить каждый раз
        apiKeyInput.value = localStorage.getItem('gemini_key') || '';
        apiKeyInput.addEventListener('change', () => {
            localStorage.setItem('gemini_key', apiKeyInput.value.trim());
        });

        cameraInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const apiKey = apiKeyInput.value.trim();
            if (!apiKey) {
                alert('Сначала вставь API-ключ!');
                return;
            }

            // Показываем превью фото
            const reader = new FileReader();
            reader.onload = async function(event) {
                const base64Full = event.target.result;
                preview.src = base64Full;
                preview.style.display = 'block';
                
                const base64Data = base64Full.split(',')[1];
                resultDiv.innerText = '⏳ Решаю...';

                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{
                                parts: [
                                    { text: "Реши задачу или ответь на вопрос с этого фото максимально быстро, коротко и понятно. Сначала напиши сам ответ, потом краткое пояснение." },
                                    { inline_data: { mime_type: file.type, data: base64Data } }
                                ]
                            }]
                        })
                    });

                    const data = await response.json();
                    if (data.error) {
                        resultDiv.innerText = 'Ошибка: ' + data.error.message;
                    } else {
                        resultDiv.innerText = data.candidates[0].content.parts[0].text;
                    }
                } catch (err) {
                    resultDiv.innerText = 'Ошибка сети: ' + err.message;
                }
            };
            reader.readAsDataURL(file);
        });
    </script>
</body>
</html>
